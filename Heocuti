// ==UserScript==
// @name         heocuti
// @match        *://bloxd.io/*
// @grant        none
// ==/UserScript==

(function () {
    'use strict';

    // ========== MENU UI ==========
    const menu = document.createElement("div");
    menu.style = `
      position: fixed; top: 60px; left: 20px;
      background: #111; color: #0f0;
      padding: 10px; border-radius: 8px;
      font-family: monospace; z-index: 99999;
    `;
    menu.innerHTML = `
      <h3>DaikaHack V2.1</h3>
      <label><input type="checkbox" id="esp"> ESP</label><br>
      <label><input type="checkbox" id="killaura"> KillAura</label><br>
      <small>Nhấn phím M để ẩn/hiện menu</small>
    `;
    document.body.appendChild(menu);

    // Toggle ẩn/hiện menu
    let visible = true;
    document.addEventListener("keydown", (e) => {
        if (e.key.toLowerCase() === "m") {
            visible = !visible;
            menu.style.display = visible ? "block" : "none";
        }
    });

    // ========== ESP ==========
    setInterval(() => {
        const checkbox = document.querySelector("#esp");
        if (!checkbox || !checkbox.checked) return;
        const players = document.querySelectorAll('[id*="Player"]');
        players.forEach(p => {
            if (!p.style.outline) {
                p.style.outline = '2px solid red';
            }
        });
    }, 500); // mỗi 0.5s quét lại

    // ========== KillAura ==========
    setInterval(() => {
        const checkbox = document.querySelector("#killaura");
        if (!checkbox || !checkbox.checked) return;
        document.dispatchEvent(new MouseEvent("click", { bubbles: true }));
    }, 60); // click tự động mỗi 60ms

})();
